class Solution {
    public boolean checkIfPangram(String sentence) {
        
        int index = 0;
        int[] arr = new int[26];
        for(int i=0;i<sentence.length(); i++){
            index = sentence.charAt(i) - 'a';
            arr[index]++;
        }
        for(int i=0; i<26; i++){
            if(arr[i] == 0 ){
                return false;
            }
        }
        return true;
        
    }
}
