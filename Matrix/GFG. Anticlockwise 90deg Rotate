class Solution {
    public void rotateMatrix(int[][] mat) {

        int n = mat.length;
        for(int i =0; i<n;i++){
            for(int j = i+1; j<n; j++){
                int temp = mat[i][j];
                mat[i][j] =mat[j][i];
                mat[j][i] = temp;
                
            }
        }    
            int start = 0;
            int end = n-1;
            while(start<end){
                int[] temp = mat[start];
                mat[start] = mat[end];
                mat[end] = temp;
                
                start++;
                end--;
            
            }
      
        
    }
}
