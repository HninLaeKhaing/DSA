class Solution {
    static ArrayList<Integer> snakePattern(int matrix[][]) {
        ArrayList<Integer> arr = new ArrayList<>();
        for(int i =0;i<matrix.length; i++){
            if(i % 2 == 0){
                for(int j = 0; j<matrix.length; j++){
                    arr.add(matrix[i][j]);
                }
            }
            else if(i % 2 != 0){
                for(int j=matrix.length-1; j>=0; j--){
                    arr.add(matrix[i][j]);
                }    
            }
        }
        return arr;
        
    }
}
