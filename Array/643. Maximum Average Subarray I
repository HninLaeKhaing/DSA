class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int left = 0;
        int right = k-1;
        int sum = 0;
        for(int i = 0; i<= right; i++){
            sum += nums[i];
        }
        double max = sum;
        while(right<nums.length-1){
            sum -= nums[left];
            left++; right++;
            sum += nums[right];
            max = Math.max(max,sum);
        }
        
        return max / k;
        
    }
}
