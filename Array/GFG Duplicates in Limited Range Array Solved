class Solution {
    public ArrayList<Integer> findDuplicates(int[] arr) {
        
        ArrayList<Integer> result = new ArrayList<>();
        HashSet<Integer> set = new HashSet<>();
        for(int i= 0; i< arr.length; i++){
            if(set.contains(arr[i])){
                result.add(arr[i]);

            }
            else{
                set.add(arr[i]);
            }
        }
        
        return result;
    }
}
