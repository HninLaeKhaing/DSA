class Solution {
    public int maxProfit(int[] prices) {
        int BuyValue = prices[0];
        int Profit = 0;

        for (int i=0 ; i < prices.length; i++){
            BuyValue = Math.min(BuyValue,prices[i]);
            Profit = Math.max(Profit,prices[i] - BuyValue);
        
        }
        return Profit;
        
    }
}
