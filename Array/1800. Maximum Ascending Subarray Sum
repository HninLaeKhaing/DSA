class Solution {
    public int maxAscendingSum(int[] nums) {
        int sum = nums[0];
        int max = nums[0];
        int i = 0;
        int j = 1;
        while(j<nums.length){
            if(nums[i]<nums[j]){
                sum = sum + nums[j];
            }
            else{
                sum = nums[j];
            }

        max = Math.max(max,sum);   
        i++;j++; 
        }
        
    return max;    
    }
}
