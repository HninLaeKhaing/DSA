class Solution {
    public int[] getThreeLargest(int arr[]) {

        int x = Integer.MIN_VALUE;
        int y = Integer.MIN_VALUE;
        int z = Integer.MIN_VALUE;

        for (int i = 0; i < arr.length; i++) {

            if (arr[i] > x) {
                z = y;
                y = x;
                x = arr[i];
            }
            else if (arr[i] > y && arr[i] != x) {
                z = y;
                y = arr[i];
            }
            else if (arr[i] > z && arr[i] != x && arr[i] != y) {
                z = arr[i];
            }
        }

        // Find how many distinct largest values exist
        int count = 0;

        if (x != Integer.MIN_VALUE)
            count++;

        if (y != Integer.MIN_VALUE)
            count++;

        if (z != Integer.MIN_VALUE)
            count++;

        int output[] = new int[count];

        if (count >= 1)
            output[0] = x;

        if (count >= 2)
            output[1] = y;

        if (count >= 3)
            output[2] = z;

        return output;
    }
}
