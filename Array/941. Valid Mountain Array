class Solution {
    public boolean validMountainArray(int[] arr) {
        int n = arr.length;
        int i = 0;
        int j = i+1;
        while(j<n && arr[i] < arr[j]){
            i++; j++;
        }
        if( i==0|| i==n-1){
            return false;
        }
        while(j<n && arr[i] > arr[j]){
            i++; j++;
        }
    return j==n;    
    }
}
