class Solution {
    public boolean validMountainArray(int[] arr) {
        int max = Integer.MIN_VALUE; 
        int index = -1;
        for(int i = 0; i< arr.length; i++){
            if(arr[i] > max){
                max = arr[i];
                index = i;

            }
        }
        if(arr.length< 3 || index == arr.length-1 || index == 0){
            return false;
        }

        int l= index-1; int r = index+1; 
        while(l >=0 ){
            if(arr[l] >= arr[l+1]){
                return false;
            }
            l--;
        }
        while(r< arr.length){
            if(arr[r] >= arr[r-1]){
                return false;
            }
            r++;
        }
        return true;
        

        
    }
}
