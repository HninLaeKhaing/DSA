
class Solution {
    public int maxProfit(int[] prices) {
        int n = prices.length;
        int totalprofit = 0;
        

        for (int i = 0; i +1 < n; i++) {
            if(prices[i+1] > prices[i]){
                totalprofit += prices[i+1] - prices[i];
            }
            
        }
        return totalprofit;
    }
        
}
